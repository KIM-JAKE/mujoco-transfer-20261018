if(NOT DEFINED PROGRAM)
  message(FATAL_ERROR "Model audit program required")
endif()
function(reject_before_connection path expected)
  execute_process(COMMAND "${PROGRAM}" 127.0.0.1 "${path}"
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 2)
  if(NOT code EQUAL 1 OR NOT err MATCHES "${expected}")
    message(FATAL_ERROR "Expected local input rejection; code=${code}; output=${out}; error=${err}")
  endif()
endfunction()
reject_before_connection("${CMAKE_CURRENT_BINARY_DIR}/m80-missing-input.csv" "Cannot open trajectory waypoint CSV")
set(bad "${CMAKE_CURRENT_BINARY_DIR}/m80-invalid-input.csv")
file(WRITE "${bad}" "0,not-a-number\n")
reject_before_connection("${bad}" "CSV needs 22 finite columns")
string(REPEAT ",0" 14 zeros)
file(WRITE "${bad}" "0,99,-0.2,0,-1.5,0,1.5,0${zeros}\n0.001,99,-0.2,0,-1.5,0,1.5,0${zeros}\n")
reject_before_connection("${bad}" "Joint position envelope exceeded")
file(REMOVE "${bad}")
