+    print('PIN_GPU_ROUTE_BEFORE_HINT_NATIVE_VERIFIED',dict(curve_evidence,fixed_pair_payload_checked=True,issued_curve_and_FR3_retiming_still_required=True),flush=True)
+    return VerifiedCubicRoute(proposed)
